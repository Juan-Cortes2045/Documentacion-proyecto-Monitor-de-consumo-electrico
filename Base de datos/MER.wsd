@startuml mer

entity User{
    + id_user: VARCHAR(10) <<PK>>
    --
    * name: VARCHAR(100) <<NOT NULL>>
    * email: VARCHAR(255) <<NOT NULL>>
    cellphone: VARCHAR(15)
    * password: VARCHAR(255) <<NOT NULL>>
    * email_verified: BOOLEAN <<NOT NULL>>
    profile_image: VARCHAR(255)
    * date_of_registation: DATETIME <<NOT NULL>>
}

entity UserConfiguration{
    + id_configuration: VARCHAR(10) <<PK>>
    --
    * id_user: VARCHAR(10) <<FK>> <<UNIQUE>>
    * notify_by_email: BOOLEAN <<NOT NULL>>
    * notify_by_push: BOOLEAN <<NOT NULL>>
    colorTheme: VARCHAR(50)
    language: VARCHAR(50)
    socialProvider: VARCHAR(50)
}

entity ProjectType{
    + id_project_type: VARCHAR(10) <<PK>>
    --
    * name: VARCHAR(50) <<UNIQUE>> <<NOT NULL>>
}

entity Project{
    + project_code: VARCHAR(10) <<PK>>
    --
    * name: VARCHAR(50) <<NOT NULL>>
    * id_project_type: VARCHAR(10) <<FK>> <<NOT NULL>>
    other_project_type: VARCHAR(50)
    * address: VARCHAR(200) <<NOT NULL>>
    * access_code: VARCHAR(8) <<UNIQUE>> <<NOT NULL>>
    description: VARCHAR(200)
    * creation_date: DATETIME <<NOT NULL>>
}

entity ProjectThresholds{
    + id_threshold: VARCHAR(10) <<PK>>
    --
    * id_project: VARCHAR(10) <<FK>> <<UNIQUE>> <<NOT NULL>>
    * daily_limit: DOUBLE <<NOT NULL>>
    * monthly_limit: DOUBLE <<NOT NULL>>
    * use_system_defaults: BOOLEAN <<NOT NULL>>
}

entity ApplianceType{
    + id_appliance_type: VARCHAR(10) <<PK>>
    --
    * name: VARCHAR(50) <<UNIQUE>> <<NOT NULL>>
}

enum DeviceStatus{
    ONLINE
    OFFLINE
}

entity Device{
    + id_device: VARCHAR(10) <<PK>>
    --
    * name: VARCHAR(50) <<NOT NULL>>
    * id_appliance_type: VARCHAR(10) <<FK>> <<NOT NULL>>
    location: VARCHAR(50)
    description: VARCHAR(200)
    * installation_date: DATETIME <<NOT NULL>>
    * device_code: VARCHAR(6) <<UNIQUE>> <<NOT NULL>>
    * api_key: VARCHAR(100) <<NOT NULL>>
}

entity DeviceStatusLog{
    + id_device_status: VARCHAR(10) <<PK>>
    --
    * id_device: VARCHAR(10) <<FK>>
    * status: DeviceStatus <<NOT NULL>>
    signal_strength: INT
    * last_seen: DATETIME <<NOT NULL>>
}

entity Measurement{
    + id_measurement: VARCHAR(10) <<PK>>
    --
    * id_device: VARCHAR(10) <<FK>> <<NOT NULL>>
    * date_time: DATETIME <<NOT NULL>>
    * voltage: DOUBLE <<NOT NULL>>
    * current: DOUBLE <<NOT NULL>>
    * activePower: DOUBLE <<NOT NULL>>
    * storedEnergy: DOUBLE <<NOT NULL>>
}

enum NotificationsStatus{
    READ
    UNREAD
}

enum RiskConsumption{
    LOW
    MEDIUM
    HIGH
    CRITICAL
}

enum AlertType{
    THRESHOLD
    CONNECTIVITY
}

enum AlertSeverity{
    WARNING
    CRITICAL
}

enum AlertStatus{
    PENDING
    RESOLVED
}

entity Alert{
    + id_alert: VARCHAR(10) <<PK>>
    --
    * id_project: VARCHAR(10) <<FK>> <<NOT NULL>>
    id_device: VARCHAR(10) <<FK>>
    * type: AlertType <<NOT NULL>>
    * severity: AlertSeverity <<NOT NULL>>
    * message_key: VARCHAR(100) <<NOT NULL>>
    * date_time: DATETIME <<NOT NULL>>
    * alert_status: AlertStatus <<NOT NULL>>
    id_consumption_level: VARCHAR(10) <<FK>>
    id_measurement: VARCHAR(10) <<FK>>
}

entity Recommendation{
    + id_recommendation: VARCHAR(10) <<PK>>
    --
    * id_project: VARCHAR(10) <<FK>> <<NOT NULL>>
    id_device: VARCHAR(10) <<FK>>
    * message_key: VARCHAR(100) <<NOT NULL>>
    * date_time: DATETIME <<NOT NULL>>
    * status: NotificationsStatus <<NOT NULL>>
}

entity ConsumptionLevel{
    + id_consumption_level: VARCHAR(10) <<PK>>
    --
    * name: RiskConsumption <<UNIQUE>> <<NOT NULL>>
    * description: VARCHAR(200) <<NOT NULL>>
    * min_limit: DOUBLE <<NOT NULL>>
    * max_limit: DOUBLE <<NOT NULL>>
}

enum Role{
    OWNER
    MEMBER
}

entity UserProject{
    + id_user: VARCHAR(10) <<PK>> <<FK>>
    + project_code: VARCHAR(10) <<PK>> <<FK>>
    --
    * role: Role <<NOT NULL>>
    * favorite: BOOLEAN <<NOT NULL>>
}

entity DeviceProject{
    + id_device: VARCHAR(10) <<PK>> <<FK>>
    + project_code: VARCHAR(10) <<PK>> <<FK>>
}


' Relationships

User ||--|| UserConfiguration
User ||--o{ UserProject
UserProject --> Role: uses

Project ||--o{ UserProject
Project ||--o{ DeviceProject
Project ||--|| ProjectThresholds
Project }o--|| ProjectType: uses
Project ||--o{ Alert
Project ||--o{ Recommendation

Device }o--|| ApplianceType: uses
Device ||--o{ Measurement
Device ||--o{ DeviceStatusLog
DeviceStatusLog --> DeviceStatus: uses
Device ||--o{ DeviceProject: uses
Device ||--o{ Alert
Device ||--o{ Recommendation

ConsumptionLevel |o--o{ Alert: uses
Measurement |o--o{ Alert: uses
Alert --> AlertType: uses
Alert --> AlertSeverity: uses
Alert --> AlertStatus: uses

Recommendation --> NotificationsStatus: uses

ConsumptionLevel --> RiskConsumption: uses

@enduml