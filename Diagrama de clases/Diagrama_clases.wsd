@startuml diagrama_clases

' ============================================================
' STRATEGY PATTERN
' ============================================================

package Strategy_Pattern{

    interface UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }

    class MemberPermissions implements UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }

    class OwnerPermissions implements UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }

    note as N_StrategyPending
        PENDIENTE DE IMPLEMENTACIÓN

        Estas tres clases expresan la intención de una
        autorización por tipo de rol para el contexto Home.

        Ninguna existe todavía en el código Java. La
        autorización real se resuelve hoy por la cadena RBAC
        genérica de cinco tablas, consultada en vivo desde
        CheckPermission, que no contiene lógica por rol.

        El enum Role (OWNER / MEMBER) existe únicamente como
        ENUM de MySQL en user_home, sin clase que lo mapee
        y sin entidad, mapper ni puerto para user_home.
    end note
}


' ============================================================
' ENUMS
' ============================================================

package enums{

    enum DeviceStatus{
        ONLINE
        OFFLINE
    }

    enum RiskConsumption {
        LOW
        MEDIUM
        HIGH
        CRITICAL
    }

    enum AlertType{
        THRESHOLD
        CONNECTIVITY
        DEVICE
        LIMIT
    }

    enum AlertStatus{
        PENDING
        RESOLVED
    }

    enum RecommendationType{
        SAVING
        PEAK_HOURS
        HIGH_CONSUMPTION
        HISTORICAL_COMPARISON
        THRESHOLD
    }

    enum RecommendationStatus{
        READ
        UNREAD
    }

    enum NotificationChannel{
        EMAIL
        PUSH
    }

    enum NotificationSourceType{
        ALERT
        RECOMMENDATION
    }

    enum NotificationDeliveryStatus{
        PENDING
        SENT
        FAILED
    }

    enum LimitPeriod{
        DAILY
        MONTHLY
    }

    enum Role{
        OWNER
        MEMBER
    }

    enum UserStatus{
        ACTIVE
        INACTIVE
        BLOCKED
    }

    enum LoginErrorType{
        INVALID_PASSWORD
        USER_NOT_FOUND
        ACCOUNT_BLOCKED
        ACCOUNT_INACTIVE
    }

    enum AuditAction{
        CREATE
        UPDATE
        DELETE
        LOGIN
        LOGIN_FAILED
        LOGOUT
    }
}


' ============================================================
' SECURITY DOMAIN
' ============================================================

package Domain_Security{

    class Person {
        - idPerson : String
        - name : String
        - lastName : String

        + rename(name : String, lastName : String) : void
    }

    ' The avatar belongs to the account, not to the human, so it lives on User.
    ' person.address was removed: home.address is the authoritative copy.
    ' person.cellphone was removed: the account is identified by email.
    ' person.lastName is optional: a Google account may not have a family name.

    class User {
        - idUser : String
        - personId : String
        - passwordHash : String
        - email : String
        - emailVerified : boolean
        - registrationDate : DateTime
        - status : UserStatus
        - failedLoginAttempts : int
        - lastLoginAt : DateTime
        - profileImage : String
        - googleSubject : String

        + canAuthenticate() : boolean
        + changePassword(newHash : PasswordHash) : void
        + changeEmail(newEmail : Email) : void
        + changeProfileImage(profileImage : String) : void
        + verifyEmail() : void
        + activate() : void
        + deactivate() : void
        + block() : void
        + incrementFailedLoginAttempts() : void
        + resetFailedLoginAttempts() : void
        + recordSuccessfulLogin(instant : DateTime) : void
        + bindGoogleAccount(googleSubject : String) : void
    }

    class UserConfiguration {
        - idConfiguration : String
        - userId : String
        - notifyByEmail : boolean
        - notifyByPush : boolean
        - colorTheme : String
        - language : String
        - socialProvider : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + configureNotifications() : void
        + changeColorTheme() : void
        + changeLanguage() : void
    }

    class PasswordResetToken {
        - idResetToken : String
        - userId : String
        - resetTokenHash : String
        - used : boolean
        - attempts : int
        - createdAt : DateTime
        - expirationAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + clearToken() : Optional<String>
        + isExpired(now : Instant) : boolean
        + isValid(now : Instant) : boolean
        + hasAttemptsLeft() : boolean
        + markUsed() : void
    }

    class UserSession {
        - idUserSession : String
        - userId : String
        - createdAt : DateTime
        - expirationAt : DateTime
        - ipAddress : String
        - userAgent : String
        - revoked : boolean
        - revokedAt : DateTime
        - revokedReason : RevocationReason
        - closedAt : DateTime

        + rotate(newExpiration : DateTime,
                 rotatedAt : DateTime) : void
        + revoke(revokedAt : DateTime,
                 reason : RevocationReason) : void
        + close(instant : DateTime) : void
        + isExpired(now : DateTime) : boolean
        + isActive(now : DateTime) : boolean
    }

    class RefreshToken {
        - idRefreshToken : String
        - userSessionId : String
        - familyId : String
        - parentId : String
        - tokenHash : String
        - status : RefreshTokenStatus
        - createdAt : DateTime
        - expiresAt : DateTime
        - rotatedAt : DateTime
        - revokedAt : DateTime
        - revokedReason : RevocationReason

        + isExpired(now : DateTime) : boolean
        + isUsable(now : DateTime) : boolean
        + isReplayed() : boolean
        + rotate(rotatedAt : DateTime) : void
        + revoke(revokedAt : DateTime,
                 reason : RevocationReason) : void
    }

    enum RevocationReason {
        REFRESH_TOKEN_REUSE
        PASSWORD_CHANGED
        ADMINISTRATIVE
    }

    enum RefreshTokenStatus {
        ACTIVE
        ROTATED
        REVOKED
        EXPIRED
    }

    class SecurityConfiguration {
        - idSecurityConfiguration : String
        - configName : String
        - configValue : String
        - description : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class PasswordPolicy {
        - idPasswordPolicy : String
        - minLength : int
        - maxLength : int
        - requireUppercase : boolean
        - requireNumbers : boolean
        - requireSymbols : boolean
        - expirationDays : int
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + validate(password : String) : boolean
    }

    class LoginErrorLog {
        - idLoginError : String
        - userId : String
        - errorType : LoginErrorType
        - description : String
        - ipAddress : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }
}


' ============================================================
' ACCESS CONTROL DOMAIN
' ============================================================

package Domain_Access_Control{

    class SystemRole {
        - idSystemRole : String
        - name : String
        - description : String
        - enabled : boolean
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class UserSystemRole {
        - userId : String
        - systemRoleId : String
        - assignedAt : DateTime
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class Permission {
        - idPermission : String
        - code : String
        - name : String
        - description : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class SystemRolePermission {
        - systemRoleId : String
        - permissionId : String
        - assignedAt : DateTime
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class AuditLog {
        - idAuditLog : String
        - userId : String
        - action : AuditAction
        - description : String
        - ipAddress : String
        - application : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    ' CheckPermission es la única vía de autorización real. Resuelve la cadena
    ' RBAC de cinco tablas contra el estado vivo, sin lógica por tipo de rol
    ' y sin roles embebidos en el JWT.
    class CheckPermission {
        + check(idUser : String, permissionCode : String) : boolean
    }
}


' ============================================================
' HOME MANAGEMENT DOMAIN
' ============================================================

package Domain_Home_Management{

    class HomeType {
        - idHomeType : String
        - name : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class HomeThresholds {
        - idThreshold : String
        - homeId : String
        - dailyLimit : double
        - monthlyLimit : double
        - useSystemDefault : boolean
        - limitPeriod : LimitPeriod
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + resetToDefaults(daily : double, monthly : double) : void
    }

    class Home{
        - idHome : String
        - name : String
        - homeTypeId : String
        - address : String
        - accessCode : String
        - description : String
        - creationDate : DateTime
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + addDevice(d : Device) : void
        + removeDevice(d : Device) : void
        + addUser(u : User, role : Role) : void
        + removeUser(u : User) : void
        + updateThresholds(daily : double, monthly : double) : void
        + getAllDevices() : List<Device>
    }

    class UserHome {
        - userId : String
        - homeId : String
        - role : Role
        - favorite : boolean
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + toggleFavorite() : void
        + leaveHome() : void
        + getPermissions() : UserPermissions
    }
}


' ============================================================
' DEVICES DOMAIN
' ============================================================

package Domain_Devices{

    class ApplianceType {
        - idApplianceType : String
        - name : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class Device {
        - idDevice : String
        - name : String
        - applianceTypeId : String
        - location : String
        - description : String
        - installationDate : DateTime
        - deviceCode : String
        - apiKey : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + takeMeasurement() : Measurement
        + updateStatus(status : DeviceStatus,
                       signal : int) : void
        + getCurrentStatus() : DeviceStatusLog
        + subscribe(o : MeasurementObserver) : void
        + unsubscribe(o : MeasurementObserver) : void
        + notify(m : Measurement) : void
    }

    class DeviceStatusLog {
        - idDeviceStatus : String
        - deviceId : String
        - status : DeviceStatus
        - signalStrength : int
        - lastSeen : DateTime
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class DeviceHome {
        - deviceId : String
        - homeId : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }
}


' ============================================================
' MONITORING DOMAIN
' ============================================================

package Domain_Measurements{

    class Measurement {
        - idMeasurement : String
        - deviceId : String
        - dateTime : DateTime
        - voltage : double
        - current : double
        - activePower : double
        - storedEnergy : double
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + getVoltage() : double
        + getCurrent() : double
        + getActivePower() : double
        + getStoredEnergy() : double
    }

    class ConsumptionLevel{
        - idConsumptionLevel : String
        - name : RiskConsumption
        - description : String
        - minLimit : double
        - maxLimit : double
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }


    package Observer_Pattern{

        interface MeasurementObserver {
            + onMeasurement(m : Measurement) : void
        }

        class AlertObserver implements MeasurementObserver {
            + onMeasurement(m : Measurement) : void
        }
    }
}


' ============================================================
' RECOMMENDATIONS MODULE
' ============================================================

package Application_Recommendations{

    class RecommendationRules {
        + evaluate(
            now : Instant,
            zone : ZoneId,
            devices : List<MonitoredDevice>,
            samples : List<HourSample>,
            limit : Optional<ConsumptionLimit>
          ) : List<Suggestion>

        + dataFrom(now : Instant, zone : ZoneId) : Instant

        + peakHours(lastWeek : List<HourSample>, zone : ZoneId) : Optional<Suggestion>
        + standby(deviceId : String, samples : List<HourSample>, now : Instant, zone : ZoneId) : Optional<Suggestion>
        + weekOverWeek(lastWeek : List<HourSample>, previousWeek : List<HourSample>) : Optional<Suggestion>
        + limitProjection(limit : ConsumptionLimit, samples : List<HourSample>, now : Instant, zone : ZoneId) : Optional<Suggestion>
        + deviceIncrease(deviceId : String, deviceSamples : List<HourSample>, now : Instant) : Optional<Suggestion>
    }

    class EvaluateRecommendationsService {
        + evaluateAll() : int
        + evaluateHome(homeId : String) : int
    }

    class RecommendationInboxService {
        + list(userId : String, homeId : String) : List<RecommendationView>
        + markRead(userId : String, idRecommendation : String) : RecommendationView
        + delete(userId : String, idRecommendation : String) : void
        + deleteRead(userId : String, homeId : String) : int
    }

    class RecommendationScheduler {
        + run() : void
    }

    class Suggestion {
        - type : RecommendationType
        - deviceId : String
        - messageKey : String
    }

    class MonitoredDevice {
        - deviceId : String
        - alwaysOn : boolean
    }

    class HourSample {
        - deviceId : String
        - hourStart : Instant
        - averagePower : double
        - energy : double
    }

    enum Period {
        DAILY
        MONTHLY
    }

    class ConsumptionLimit {
        - period : Period
        - kwh : double
    }

    class RecommendationCreated {
        - idRecommendation : String
        - homeId : String
        - deviceId : String
        - type : RecommendationType
        - messageKey : String
        - dateTime : Instant
    }

    note as N_RecommendationRules
        La generación es por evaluación periódica (scheduler
        cada hora), no por patrón Observer.

        RecommendationRules es un servicio de dominio puro
        (sin I/O ni framework): recibe muestras horarias y
        umbrales y devuelve Suggestion.

        EvaluateRecommendationsService persiste con cool-down
        de 7 días por hogar + tipo + dispositivo y publica
        RecommendationCreated, que notification entrega por
        email y web push.
    end note
}


' ============================================================
' NOTIFICATIONS DOMAIN
' ============================================================

package Domain_Notifications{

    class Alert {
        - idAlert : String
        - homeId : String
        - deviceId : String
        - type : AlertType
        - messageKey : String
        - dateTime : DateTime
        - alertStatus : AlertStatus
        - consumptionLevelId : String
        - measurementId : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + resolveAlert() : void
    }

    class Recommendation {
        - idRecommendation : String
        - homeId : String
        - deviceId : String
        - type : RecommendationType
        - messageKey : String
        - dateTime : DateTime
        - status : RecommendationStatus
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + markRead() : void
        + isRead() : boolean
    }

    ' Notification es el registro de la ENTREGA de un mensaje, no el evento
    ' que lo originator. Por eso deja de ser la clase base de Alert y
    ' Recommendation: son tablas independientes de sus propios contextos,
    ' y esta los referencia por sourceType + sourceId.

    class Notification {
        - idNotification : String
        - userId : String
        - homeId : String
        - channel : NotificationChannel
        - sourceType : NotificationSourceType
        - sourceId : String
        - messageKey : String
        - deliveryStatus : NotificationDeliveryStatus
        - sentAt : DateTime
        - readAt : DateTime
        - failureReason : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime

        + markAsSent(sentAt : DateTime) : void
        + markAsFailed(reason : String) : void
        + markAsRead(readAt : DateTime) : void
    }

    class NotificationPreference {
        - userId : String
        - emailEnabled : boolean
        - pushEnabled : boolean
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    class PushSubscription {
        - idPushSubscription : String
        - userId : String
        - endpoint : String
        - p256dh : String
        - auth : String
        - createdAt : DateTime
        - updatedAt : DateTime
        - deletedAt : DateTime
    }

    note as N_NotificationDelivery
        Una notificación registra que un mensaje LLEGÓ al usuario,
        no el hecho que lo generó.

        deliveryStatus y readAt son ciclos distintos:
        una alerta entregada no es una alerta resuelta.

        channel se elige según las preferencias del destinatario
        en UserConfiguration: notifyByEmail y notifyByPush.
    end note
}


' ============================================================
' FACTORY METHOD PATTERN
' ============================================================

package Factory_Method_Pattern{

    class AlertFactory {
        + createFromMeasurement(
            m : Measurement,
            risk : RiskConsumption
          ) : Alert

        + createFromDeviceStatus(
            home : Home,
            device : Device
          ) : Alert
    }

    class NotificationFactory {
        + createForAlert(
            alert : Alert,
            recipient : User,
            channel : NotificationChannel
          ) : Notification

        + createForRecommendation(
            recommendation : Recommendation,
            recipient : User,
            channel : NotificationChannel
          ) : Notification
    }
}


' ============================================================
' RELATIONSHIPS
' ============================================================

' ----------------------------
' Strategy
' ----------------------------

UserHome ..> UserPermissions : use
UserHome ..> Role : use


' ----------------------------
' Singleton
' ----------------------------

' SystemConfig se eliminó de este diagrama. Los límites por defecto del
' sistema no viven en la base de datos: se leen de la configuración de la
' aplicación (home.defaults.daily-limit = 6 kWh y home.defaults.monthly-limit
' = 180 kWh) a través de SystemDefaultsPort / HomeProperties. La única
' estructura de configuración persistente del sistema es SecurityConfiguration,
' un par genérico nombre/valor.
'
' HomeThresholds.useSystemDefault = true indica que el hogar usa esos
' defaults; resetToDefaults() los vuelve a aplicar (limitePeriod = DAILY).


' ----------------------------
' Security
' ----------------------------

Person "1" -- "1" User

User "1" *-- "1" UserConfiguration

User "1" -- "0..*" PasswordResetToken
User "1" -- "0..*" UserSession
UserSession "1" *-- "1..*" RefreshToken
RefreshToken "0..1" -- "1" RefreshToken : parent
RefreshToken ..> RefreshTokenStatus : use
UserSession ..> RevocationReason : use
RefreshToken ..> RevocationReason : use
User "0..1" -- "0..*" LoginErrorLog

User ..> UserStatus : use
LoginErrorLog ..> LoginErrorType : use


' ----------------------------
' Access Control
' ----------------------------

User "1" -- "0..*" UserSystemRole
SystemRole "1" -- "0..*" UserSystemRole

SystemRole "1" -- "0..*" SystemRolePermission
Permission "1" -- "0..*" SystemRolePermission

User "0..1" -- "0..*" AuditLog
AuditLog ..> AuditAction : use

CheckPermission ..> User : verifies
CheckPermission ..> Permission : resolves
CheckPermission ..> UserSystemRole : traverses
CheckPermission ..> SystemRole : traverses
CheckPermission ..> SystemRolePermission : traverses


' ----------------------------
' Home Management
' ----------------------------

Home "*" o-- "1" HomeType : uses
Home "1" *-- "1" HomeThresholds
HomeThresholds ..> LimitPeriod : use
Home "1" -- "0..*" UserHome

UserHome ..> User : references
UserHome ..> Role : use


' ----------------------------
' Devices
' ----------------------------

Device "*" o-- "1" ApplianceType : uses

Device "1" *-- "0..*" DeviceStatusLog
DeviceStatusLog ..> DeviceStatus : use

Device "1" -- "0..*" DeviceHome


' ----------------------------
' Monitoring
' ----------------------------

Device ..> Measurement : references
Measurement ..> Device : references

ConsumptionLevel ..> RiskConsumption : use


' ----------------------------
' Observer Pattern
' ----------------------------

Device ..> MeasurementObserver : notify

AlertObserver ..> AlertFactory : uses


' ----------------------------
' Alerts
' ----------------------------

Alert ..> AlertType : use
Alert ..> AlertStatus : use
Alert ..> ConsumptionLevel : references
Alert ..> Measurement : references


' ----------------------------
' Recommendations
' ----------------------------

Recommendation ..> RecommendationType : use
Recommendation ..> RecommendationStatus : use

RecommendationScheduler ..> EvaluateRecommendationsService : triggers
EvaluateRecommendationsService ..> RecommendationRules : uses
EvaluateRecommendationsService ..> Recommendation : creates
EvaluateRecommendationsService ..> RecommendationCreated : publishes
RecommendationInboxService ..> Recommendation : manages

RecommendationRules ..> Suggestion : produces
RecommendationRules ..> HourSample : reads
RecommendationRules ..> MonitoredDevice : reads
RecommendationRules ..> ConsumptionLimit : reads
ConsumptionLimit ..> Period : use
RecommendationCreated ..> RecommendationType : use


' ----------------------------
' Notifications
' ----------------------------

Notification ..> NotificationChannel : use
Notification ..> NotificationSourceType : use
Notification ..> NotificationDeliveryStatus : use

Notification ..> User : recipient
Notification ..> Home : scoped to

NotificationFactory ..> Notification : creates

NotificationPreference ..> Notification : defines channel
NotificationPreference ..> User : belongs to
PushSubscription ..> Notification : delivers to
PushSubscription ..> User : belongs to
NotificationFactory ..> Alert : delivers
NotificationFactory ..> Recommendation : delivers
NotificationFactory ..> UserConfiguration : reads channel preference


' ----------------------------
' Cross-context references
' ----------------------------

Home ..> Device : references
Home ..> Alert : references
Home ..> Recommendation : references

Device ..> Alert : references
Device ..> Recommendation : references

@enduml