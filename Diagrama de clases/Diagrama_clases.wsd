@startuml diagrama_clases

package Strategy_Pattern{

    interface UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }

    class MemberPermissions implements UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }
    class OwnerPermissions implements UserPermissions {
        + canManageDevices() : boolean
        + canManageHome() : boolean
    }
}

package Singleton_Pattern{

    class SystemConfig {
        - instance : SystemConfig {static}
        - defaultDailyLimit : double
        - defaultMonthlyLimit : double
        - defaultLanguage: String
        - SystemConfig()
        + getInstance() : SystemConfig {static}
        + getDefaultDailyLimit() : double
        + getDefaultMonthlyLimit() : double
        + getDefaultLanguage(): String
    }
}

package enums{
    enum DeviceStatus{
        ONLINE
        OFFLINE
    }

    enum RiskConsumption {
        LOW
        MEDIUM
        HIGH
        CRITICAL
    }

    enum AlertType{
        THRESHOLD
        CONNECTIVITY
    }

    enum AlertSeverity{
        WARNING
        CRITICAL
    }
    note bottom of AlertSeverity
        No se persiste. Se calcula
        en backend a partir de
        ConsumptionLevel (THRESHOLD)
        o de la regla de conectividad
        (CONNECTIVITY).
    end note

    enum AlertStatus{
        PENDING
        RESOLVED
    }

    enum NotificationsStatus{
        READ
        UNREAD
    }

    enum Role{
        OWNER
        MEMBER
    }

    enum UserStatus{
        ACTIVE
        INACTIVE
        BLOCKED
    }

    enum LoginErrorType{
        INVALID_PASSWORD
        USER_NOT_FOUND
        ACCOUNT_BLOCKED
        ACCOUNT_INACTIVE
    }

    enum AuditAction{
        CREATE
        UPDATE
        DELETE
        LOGIN
        LOGIN_FAILED
        LOGOUT
    }
}

package Domain_Security{

    class Person {
        - idPerson : String
        - name : String
        - lastName : String
        - cellphone : String
        - address : String
        - profileImage : String
        + updateInfo() : void
    }

    class User {
        - idUser : String
        - passwordHash : String
        - email : String
        - emailVerified : boolean
        - dateOfRegistration : Date
        - status : UserStatus
        - failedLoginAttempts : int
        - lastLoginAt : DateTime
        + register() : void
        + login() : void
        + logout() : void
        + updateInfo() : void
        + deleteAccount() : void
        + requestPasswordReset() : PasswordResetToken
        + resetPassword(token : PasswordResetToken, newPassword : String) : void
    }

    class UserConfiguration {
        - notifyByEmail : boolean
        - notifyByPush : boolean
        - colorTheme: String
        - language: String
        - socialProvider: String
        + configureNotifications() : void
        + changeColorTheme(): void
        + changeLanguage():void
    }

    class PasswordResetToken {
        - idResetToken : String
        - resetToken : String
        - used : boolean
        - createdAt : DateTime
        - expirationAt : DateTime
        + isExpired() : boolean
        + markAsUsed() : void
    }

    class UserSession {
        - idUserSession : String
        - refreshToken : String
        - revoked : boolean
        - ipAddress : String
        - userAgent : String
        - createdAt : DateTime
        - expirationAt : DateTime
        - closedAt : DateTime
        + revoke() : void
        + close() : void
        + isValid() : boolean
    }

    class SecurityConfiguration {
        - idSecurityConfiguration : String
        - configName : String
        - configValue : String
        - description : String
    }

    class PasswordPolicy {
        - idPasswordPolicy : String
        - minLength : int
        - maxLength : int
        - requireUppercase : boolean
        - requireNumbers : boolean
        - requireSymbols : boolean
        - expirationDays : int
        + validate(password : String) : boolean
    }

    class LoginErrorLog {
        - idLoginError : String
        - errorType : LoginErrorType
        - description : String
        - ipAddress : String
        - createdAt : DateTime
    }
}

package Domain_Access-Control{

    class SystemRole {
        - idSystemRole : String
        - name : String
        - description : String
        - enabled : boolean
        - createdAt : DateTime
    }

    class UserSystemRole {
        - assignedAt : DateTime
    }

    class Permission {
        - idPermission : String
        - code : String
        - name : String
        - description : String
    }

    class SystemRolePermission {
        - assignedAt : DateTime
    }

    class AuditLog {
        - idAuditLog : String
        - action : AuditAction
        - description : String
        - ipAddress : String
        - application : String
        - createdAt : DateTime
    }
}

package Domain_Home-Management{

    class HomeType {
        - idHomeType : String
        - name : String
    }

    class HomeThresholds {
        - idThreshold : String
        - dailyLimit : double
        - monthlyLimit : double
        - useSystemDefaults : boolean
        + resetToDefaults() : void
    }

    class Home{
        - homeCode: String
        - name: String
        - address: String
        - accessCode: String
        - description: String
        - creationDate: Date
        + addDevice(d: Device): void
        + removeDevice(d: Device): void
        + addUser(u: User, role: Role): void
        + removeUser(u: User): void
        + updateThresholds(daily: double, monthly: double): void
        + getAllDevices(): List<Device>
    }

    class UserHome {
        - role : Role
        - favorite : boolean
        + toggleFavorite() : void
        + leaveHome() : void
        + getPermissions() : UserPermissions
    }
}

package Domain_Devices{

    class ApplianceType {
        - idApplianceType : String
        - name : String
    }

    class Device {
        - idDevice : String
        - name : String
        - location : String
        - description : String
        - installationDate : Date
        - deviceCode : String
        - apiKey : String
        - observers : List<MeasurementObserver>
        + takeMeasurement() : Measurement
        + updateStatus(status : DeviceStatus, signal : int) : void
        + getCurrentStatus() : DeviceStatusLog
        + subscribe(o : MeasurementObserver) : void
        + unsubscribe(o : MeasurementObserver) : void
        + notify(m : Measurement) : void
    }

    class DeviceStatusLog {
        - idDeviceStatus : String
        - status : DeviceStatus
        - signalStrength : int
        - lastSeen : DateTime
    }
}

package Domain_Measurements{
    class Measurement {
        - idMeasurement : String
        - datetime : LocalDateTime
        - voltage : double
        - current : double
        - activePower : double
        - storedEnergy : double
        + getVoltage() : double
        + getCurrent() : double
        + getActivePower() : double
        + getStoredEnergy() : double
    }

package Observer_Pattern{
    interface MeasurementObserver {
        + onMeasurement(m : Measurement) : void
    }

    class AlertObserver implements MeasurementObserver {
        + onMeasurement(m : Measurement) : void
    }

    class RecommendationObserver implements MeasurementObserver {
        + onMeasurement(m : Measurement) : void
    }
}

package Domain_Notifications{
    abstract class Notification {
        - messageKey : String
        - home : Home
        - device : Device
        - datetime : LocalDateTime
        + generate() : void
        + send() : void
    }
    class ConsumptionLevel{
        - idConsumptionLevel: String
        - name: RiskConsumption
        - description: String
        - minLimit: double
        - maxLimit: double
    }
    class Alert extends Notification {
        - idAlert : String
        - type : AlertType
        - status : AlertStatus
        - consumptionLevel : ConsumptionLevel
        - measurement : Measurement
        + resolveAlert() : void
        + getSeverity() : AlertSeverity
    }

    class Recommendation extends Notification {
        - idRecommendation : String
        - status : NotificationsStatus
        + markAsRead() : void
        + applyRecommendation(): void
    }
}

package Factory_Method_Pattern{
    abstract class NotificationFactory {
        + createFromMeasurement(m : Measurement, risk : RiskConsumption) : Notification
        + createFromDeviceStatus(home : Home, device : Device) : Notification
    }

    class AlertFactory extends NotificationFactory {
        + createFromMeasurement(m : Measurement, risk : RiskConsumption) : Alert
        + createFromDeviceStatus(home : Home, device : Device) : Alert
    }

    class RecommendationFactory extends NotificationFactory {
        + createFromMeasurement(m : Measurement, risk : RiskConsumption) : Recommendation
        + createFromDeviceStatus(home : Home, device : Device) : Recommendation
    }
}

' ==================== Relationships ====================

' Strategy (ligado a UserHome porque el rol es por hogar, no global)
UserHome ..> UserPermissions : use
UserHome ..> Role : use

' Singleton
UserConfiguration ..> SystemConfig
User ..> SystemConfig : use
HomeThresholds ..> SystemConfig : use defaults

' Security - identidad y sesión
Person "1" -- "1" User
User "1" *-- "1" UserConfiguration
User "1" -- "0..*" PasswordResetToken
User "1" -- "0..*" UserSession
User "0..1" -- "0..*" LoginErrorLog
User ..> UserStatus : use
LoginErrorLog ..> LoginErrorType : use

' Access control (RBAC)
User "1" -- "0..*" UserSystemRole
SystemRole "1" -- "0..*" UserSystemRole
SystemRole "1" -- "0..*" SystemRolePermission
Permission "1" -- "0..*" SystemRolePermission
User "1" -- "0..*" AuditLog
AuditLog ..> AuditAction : use

' Home management
User "1" -- "0..*" UserHome
Home "1" -- "0..*" UserHome
Home "1" *-- "1" HomeThresholds
Home "*" o-- "1" HomeType : uses
Home "0..*" o-- "0..*" Device : uses
Home "1" o-- "0..*" Alert
Home "1" o-- "0..*" Recommendation

' Devices
Device "*" o-- "1" ApplianceType : uses
Device "1" *-- "0..*" DeviceStatusLog
DeviceStatusLog ..> DeviceStatus : use
Device "1" o-- "0..*" Alert
Device "1" o-- "0..*" Recommendation

' Measurements
Device "1" *-- "0..*" Measurement

' Observer
Device ..> MeasurementObserver : notify

' Factory Method
AlertFactory ..> Alert : create
RecommendationFactory ..> Recommendation : create
Alert ..> RiskConsumption
Alert ..> AlertType
Alert ..> AlertStatus
Alert ..> AlertSeverity
Recommendation ..> NotificationsStatus
ConsumptionLevel ..> RiskConsumption

@enduml
